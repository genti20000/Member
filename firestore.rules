rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'londonkaraokeclubsoho@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Connection validation test path
    match /test/{docId} {
      allow read, write: if true;
    }

    // Members Directory & Applications
    match /members/{memberId} {
      allow read: if true;
      allow create, update: if isValidId(memberId);
      allow delete: if isAdmin();
    }

    // Door Visits & Attendance Register
    match /visits/{visitId} {
      allow read: if true;
      allow create, update: if isValidId(visitId);
      allow delete: if isAdmin();
    }

    // Incident Log Register
    match /incidents/{incidentId} {
      allow read: if true;
      allow create, update: if isValidId(incidentId);
      allow delete: if false; // Statutory audit requirement
    }

    // Audit Logs & Hourly Capacity
    match /audit_logs/{logId} {
      allow read: if true;
      allow create: if isValidId(logId);
      allow update, delete: if false;
    }

    // Club Rules Versions
    match /club_rules/{ruleId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
